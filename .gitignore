# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local scratch (created during setup in sandbox)
.npm-cache/
.appdata/

# local scratch dumps (not part of the project)
/body403.txt

# runtime SQLite database (committed seed content lives under data/seed/)
/data/site.db
/data/site.db-shm
/data/site.db-wal

# scratch build dirs
.tmp-build/

# Cloudflare / OpenNext
/.open-next/
/.wrangler/
.dev.vars
.dev.vars.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
