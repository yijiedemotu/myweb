{
  // Cloudflare Workers 部署配置。
  // 更详细的字段说明见 https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",

  // opennextjs-cloudflare build 的产物入口。
  "main": ".open-next/worker.js",
  // Worker 名称。必须与 Cloudflare 上实际存在的 Worker 一致，
  // 否则 wrangler deploy 会新建一个同名 Worker 而不是更新现有的。
  // 线上现有的 Worker 名字是 myweb（与 Git 仓库同名）。
  "name": "myweb",

  // 兼容日期：决定 workerd 采用哪一版运行时语义，只能用已发布的日期。
  "compatibility_date": "2026-09-01",
  // nodejs_compat 是 OpenNext 的硬性要求；lib/auth.ts 里的 node:crypto HMAC 靠它。
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // ⚠️ 关闭 myweb.<子域>.workers.dev 访问，只允许通过自定义域名访问站点。
  // 前置条件：自定义域名（cvetryu.cn / www.cvetryu.cn）必须已经生效，
  // 否则部署完之后将没有任何入口能打开站点。
  // 关掉它的另一个好处：workers.dev 在国内被 DNS 污染，留着只会造成困惑。
  "workers_dev": false,
  // 同时关闭每次部署生成的 <版本>-myweb.<子域>.workers.dev 预览地址。
  "preview_urls": false,

  // 静态资源（public/ 与构建产物）作为 Worker 的 assets 提供。
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  // 内容数据库。先执行下面这条命令创建，再把输出的 database_id 填进来：
  //   npx wrangler d1 create portfolio-website-db
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-website-db",
      "database_id": "199047e2-8fbd-4f81-b733-f4d45105b65c",
    },
  ],

  // 在 Cloudflare 控制台里能直接看 Worker 日志，排障用。
  "observability": {
    "enabled": true,
  },
}
